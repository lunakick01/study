# ---- Database (Prisma) ----
# 로컬 Supabase Postgres. `npx supabase start` 후 `npx supabase status` 로 확인.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---- Supabase (클라이언트/SSR) ----
# 로컬 개발용 기본 키. `npx supabase status` 출력의 API URL / anon key / service_role key 를 그대로 사용.
